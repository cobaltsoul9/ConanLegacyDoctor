<Window x:Class="ConanLegacyDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conan Legacy Doctor"
        Width="1240"
        Height="860"
        MinWidth="1020"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/AppIcon.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Width="58" Height="58" Margin="0,0,14,0" CornerRadius="6" Background="#18202A">
                    <Image Source="/Assets/AppIcon.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Conan Legacy Doctor" FontSize="24" FontWeight="SemiBold" Foreground="#18202A"/>
                    <TextBlock Text="Native branch triage, reversible cleanup, and support bundle export." Foreground="#53606F" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" Padding="12,8" CornerRadius="6" Background="#E7EDF4" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="Detected branch" Foreground="#526170" FontSize="12"/>
                    <TextBlock x:Name="BranchStatusText" Text="Not scanned" FontWeight="SemiBold" Foreground="#18202A" Margin="0,3,0,0"/>
                    <TextBlock x:Name="BranchRoleText" Text="Choose or scan an install." Foreground="#526170" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Conan install" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox x:Name="GameRootText" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse" Width="92" Height="32" Margin="10,0,0,0" Click="BrowseButton_Click" ToolTip="Pick the Conan install folder yourself if the doctor cannot find it."/>
            <Button x:Name="ScanButton" Grid.Column="3" Content="Scan" Width="92" Height="32" Margin="10,0,0,0" Background="#2A6FDB" Foreground="White" Click="ScanButton_Click" ToolTip="Start here. The doctor checks what it sees before changing anything."/>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Start Here">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Padding="16" Background="#FFFFFF" BorderBrush="#D2D9E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="The simplest path" FontSize="18" FontWeight="SemiBold" Foreground="#18202A"/>
                                    <TextBlock Text="Use this when you are tired and just want the selected install to get a fair, clean try." Foreground="#53606F" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                    <TextBlock Text="1. Press Scan. If asked, choose the Conan install you want to repair." Margin="0,0,0,7" TextWrapping="Wrap"/>
                                    <TextBlock Text="2. Leave the extra boxes off on the first attempt. Press Prepare." Margin="0,0,0,7" TextWrapping="Wrap"/>
                                    <TextBlock Text="3. Press Launch Vanilla Test. Let the game reach the menu before judging the result." Margin="0,0,0,7" TextWrapping="Wrap"/>
                                    <TextBlock Text="4. If you want everything put back, open Actions, pick the action, and press Undo Selected." TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Scan" Width="96" Height="32" Margin="0,0,10,0" Background="#2A6FDB" Foreground="White" Click="ScanButton_Click"/>
                                        <Button x:Name="StartPrepareButton" Content="Prepare" Width="138" Height="32" Margin="0,0,10,0" Background="#2C8A57" Foreground="White" Click="PrepareButton_Click"/>
                                        <Button x:Name="StartLaunchButton" Content="Launch Vanilla Test" Width="166" Height="32" Background="#2A6FDB" Foreground="White" Click="LaunchVanillaButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" Background="#FFFFFF" BorderBrush="#D2D9E1" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="If the first try still hangs" FontSize="18" FontWeight="SemiBold" Foreground="#18202A"/>
                                    <TextBlock Text="Try one stronger option at a time so you know what helped." Foreground="#53606F" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Quarantine local save DBs: Use this when the problem feels tied to loading a local save after Enhanced touched it." Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="Quarantine whole Mods directory: Use this when you want the strongest mod isolation, not just the active mod list." Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="Reset client config folder: Use this when old settings may be the thing keeping the selected install from booting cleanly." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Padding="16" Background="#EAF2FB" BorderBrush="#C7D8EE" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="What the words mean" FontSize="18" FontWeight="SemiBold" Foreground="#18202A"/>
                                    <TextBlock Text="Actions" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="A readable list of what the doctor changed. This is where Undo lives." TextWrapping="Wrap"/>
                                    <TextBlock Text="Vanilla" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="A clean launch without an active mod list, useful when testing whether the selected install itself can boot." TextWrapping="Wrap"/>
                                    <TextBlock Text="Quarantine" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="Move aside safely and record how to restore it. The doctor prefers reversible moves over deleting." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" Background="#FFF7E8" BorderBrush="#E8D39E" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="Small tips" FontSize="18" FontWeight="SemiBold" Foreground="#18202A"/>
                                    <TextBlock Text="Use Scan again after a repair step so you can see what changed." Margin="0,12,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="Support Bundle is for sharing a clean troubleshooting package. It does not include save DB files." Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="If both Legacy and Enhanced are installed, read the folder choice carefully before pressing repair buttons." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,12" Background="#EAF2FB" BorderBrush="#C7D8EE" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="Recommended first attempt: Scan, leave all three boxes off, press Prepare, then Launch Vanilla Test. Tick extra boxes only when the simpler pass does not help." Foreground="#243447" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="QuarantineModsCheck" Content="Quarantine whole Mods directory" Margin="0,0,18,8" ToolTip="Stronger mod isolation. Use after the simple repair pass if mods may still be involved."/>
                            <CheckBox x:Name="ResetConfigCheck" Content="Reset client config folder for clean test" Margin="0,0,18,8" ToolTip="Moves local client settings aside so Conan can rebuild them for the test."/>
                            <CheckBox x:Name="QuarantineSavesCheck" Content="Quarantine local save DBs for fresh vanilla boot" Margin="0,0,18,8" ToolTip="Moves local save databases aside after making safety copies, so the selected install can try a fresh local database."/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PrepareButton" Content="Prepare" Width="150" Height="34" Margin="0,0,10,0" Background="#2C8A57" Foreground="White" Click="PrepareButton_Click" ToolTip="Records a reversible repair action for the selected install."/>
                            <Button x:Name="LaunchVanillaButton" Content="Launch Vanilla Test" Width="170" Height="34" Background="#2A6FDB" Foreground="White" Click="LaunchVanillaButton_Click" ToolTip="Starts the selected install in the clean test path after the active mod list has been moved aside."/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="FindingsGrid"
                              Grid.Row="2"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="220"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="360"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="ToT Saves">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,12" Background="#EEF7F0" BorderBrush="#C9DEC8" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="Use this to load a dated TotCustom backup into the install selected at the top of the app. The doctor first moves the current TotCustom folder aside in a reversible action, then loads the chosen source." Foreground="#243447" TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid x:Name="TotCustomSourcesGrid"
                              Grid.Row="1"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              AlternationCount="2"
                              SelectionChanged="TotCustomSourcesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Choose This" Binding="{Binding DisplayName}" Width="260"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="170"/>
                            <DataGridTextColumn Header="When" Binding="{Binding CapturedAtUtc}" Width="220"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="White" BorderBrush="#D2D9E1" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                        <TextBox x:Name="TotCustomSourceDetailsText"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="RefreshTotCustomSourcesButton" Content="Refresh Sources" Width="138" Height="32" Margin="0,0,10,0" Click="RefreshTotCustomSourcesButton_Click" ToolTip="Reload Doctor backups and any detected live Enhanced TotCustom folder."/>
                        <Button x:Name="RestoreTotCustomButton" Content="Load Into Selected Install" Width="210" Height="32" Background="#2C8A57" Foreground="White" Click="RestoreTotCustomButton_Click" ToolTip="Safely replace the selected install's TotCustom folder with this dated source. The current folder is preserved in a reversible action first."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Actions">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ActionsGrid"
                              Grid.Row="0"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              AlternationCount="2"
                              SelectionChanged="ActionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action Id" Binding="{Binding Id}" Width="240"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="What the doctor did" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="210"/>
                            <DataGridTextColumn Header="Game Root" Binding="{Binding GameRoot}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D2D9E1" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                        <TextBox x:Name="ActionDetailsText"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <CheckBox x:Name="ForceRestoreCheck" Content="Force overwrite changed restore targets" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="RefreshActionsButton" Content="Refresh" Width="100" Height="32" Margin="0,0,10,0" Click="RefreshActionsButton_Click"/>
                        <Button x:Name="RestoreButton" Content="Undo Selected" Width="140" Height="32" Background="#8A4B2C" Foreground="White" Click="RestoreButton_Click" ToolTip="Restores the selected recorded action when it is safe to do so."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Support Bundle">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="The bundle always includes scan and action summaries. Logs and config snapshots are explicit opt-ins."
                               Foreground="#53606F"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
                        <CheckBox x:Name="IncludeLogsCheck" Content="Include recent log tails" Margin="0,0,18,0"/>
                        <CheckBox x:Name="IncludeConfigCheck" Content="Include Engine.ini, Game.ini, and modlist.txt snapshots"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="ExportBundleButton" Content="Export ZIP Bundle" Width="170" Height="36" Background="#5D5BCE" Foreground="White" Click="ExportBundleButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Activity" FontWeight="SemiBold" Foreground="#18202A" Margin="0,0,0,8"/>
            <TextBox x:Name="ActivityText"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="10"
                     Background="White"/>
        </Grid>
    </Grid>
</Window>
